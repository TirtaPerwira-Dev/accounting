# Production Environment Configuration
# Copy this to .env on your hosting server and update the values

APP_NAME=accounting-app
APP_ENV=production
APP_KEY=  # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com  # IMPORTANT: Use your actual domain with https://

DB_CONNECTION=mysql
DB_HOST=36.93.220.245
DB_PORT=3306
DB_DATABASE=accounting_db
DB_USERNAME=root
DB_PASSWORD=pdamadmin123

# Session Configuration for Production
# CRITICAL: Set these correctly to fix login issues
SESSION_DRIVER=database  # Use database for shared hosting
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com  # Set to your actual domain (without https://)
SESSION_SECURE_COOKIE=true  # MUST be true for HTTPS
SESSION_SAME_SITE=lax

# Cache Configuration
CACHE_STORE=database
CACHE_PREFIX=

# Queue Configuration
QUEUE_CONNECTION=database

# Mail Configuration (update with your SMTP settings)
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-email@your-domain.com
MAIL_PASSWORD=your-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error  # Use 'error' in production, not 'debug'

# Localization
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# IMPORTANT NOTES:
# 1. Run these commands after setting up .env:
#    - php artisan key:generate
#    - php artisan migrate --force
#    - php artisan storage:link
#    - php artisan filament:optimize
#    - php artisan config:cache
#    - php artisan route:cache
#    - php artisan view:cache
#
# 2. Make sure storage/framework/sessions directory exists and is writable
# 3. If using file session driver, ensure proper permissions on storage/
# 4. For shared hosting, 'database' session driver is recommended
